      "processing:expression": {
        "format": "duckdb-sql",
        "expression": "SELECT o.*\nFROM read_parquet('https://overturemaps-us-west-2.s3.us-west-2.amazonaws.com/release/2026-11-18.0/theme=buildings/type=building/part-00066-e108a8a4-b023-50e7-bd24-3baaefcef5cc-c000.zstd.parquet', hive_partitioning = false) AS o,\n     (SELECT geometry AS partido FROM read_parquet('https://data.source.coop/nlebovits/pergamino-ide/limites/partido_pergamino/partido_pergamino.parquet')) AS p\nWHERE o.bbox.xmin <= -60.13879236 AND o.bbox.xmax >= -60.94404785 AND o.bbox.ymin <= -33.54021703 AND o.bbox.ymax >= -34.17655855\n  AND ST_Intersects(o.geometry, p.partido)"
