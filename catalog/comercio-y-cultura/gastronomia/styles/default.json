{
  "version": 8,
  "name": "gastronomia",
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../gastronomia.pmtiles",
      "minzoom": 0,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "sld-0-circle",
      "type": "circle",
      "source": "data",
      "source-layer": "gastronomia",
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "tipo"
          ],
          "Bar",
          "#eb8ee0",
          "Café",
          "#6f4bd2",
          "Heladeria",
          "#64ecaf",
          "Pizzería",
          "#efdb7a",
          "Restaurante",
          "#85d165",
          "Resto-bar",
          "#388dca",
          "#ee2f32"
        ],
        "circle-opacity": 1.0,
        "circle-radius": 3.5,
        "circle-stroke-color": "#232323",
        "circle-stroke-width": 0.5,
        "circle-stroke-opacity": 1.0
      }
    },
    {
      "id": "categorical-circle-labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "gastronomia",
      "layout": {
        "text-field": [
          "get",
          "nombre"
        ],
        "text-size": 13.0,
        "text-anchor": "left",
        "text-font": [
          "Noto Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#000000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.0
      }
    }
  ]
}
