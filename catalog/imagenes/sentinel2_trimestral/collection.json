        "producer",
        "licensor"
      ],
      "url": "https://sentinels.copernicus.eu/"
    },
    {
      "name": "Element 84",
      "description": "Publica los productos L2A como COG y el catálogo STAC Earth Search. Aloja los archivos a los que apuntan los ítems.",
      "roles": [
        "processor"
      ],
      "url": "https://element84.com"
    },
    {
